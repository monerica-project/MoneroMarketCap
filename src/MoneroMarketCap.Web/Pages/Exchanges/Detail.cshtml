@page "/exchanges/{slug}"
@model MoneroMarketCap.Pages.Exchanges.DetailModel
@{
    var ex = Model.Exchange;
    string Humanize(string? s) => MoneroMarketCap.Pages.Coins.DetailModel.Humanize(s);
    // Brand searches look like "changenow monero" / "flashift": lead the title with the
    // name + Monero. The layout appends " - MoneroMarketCap" (18 chars) -> keep <= 52.
    var exTitle = Model.SupportsXmr
        ? $"{ex.Name} Monero (XMR) Swaps: KYC, Fees & {Model.CoinTotal} Coins"
        : $"{ex.Name}: KYC, Fees & {Model.CoinTotal} Supported Coins";
    if (exTitle.Length > 52) exTitle = Model.SupportsXmr ? $"{ex.Name} Monero (XMR) Swaps: KYC & Fees" : $"{ex.Name}: KYC, Fees & Coins";
    ViewData["Title"] = exTitle;
    // NOTE: the layout reads ViewData["MetaDescription"]; this page used to set
    // ViewData["Description"], so every exchange page shipped the generic site description.
    var exFees = MoneroMarketCap.Pages.Coins.DetailModel.FormatFees(ex);
    var exFacts = new List<string>();
    if (!string.IsNullOrEmpty(ex.Grade)) exFacts.Add($"grade {ex.Grade}");
    var kycPhrase = ex.Kyc switch
    {
        "Never" => "no KYC",
        "Rare" => "KYC rare",
        null or "" or "NotStated" => null,
        _ => $"KYC {Humanize(ex.Kyc).ToLowerInvariant()}"
    };
    if (kycPhrase != null) exFacts.Add(kycPhrase);
    if (exFees != "—") exFacts.Add($"fees {exFees.ToLowerInvariant()}");
    var exDesc = $"{ex.Name}{(Model.SupportsXmr ? " Monero (XMR) swaps" : "")}: {string.Join(", ", exFacts)}. See all {Model.CoinTotal} supported coins{(string.IsNullOrEmpty(ex.MonericaSlug) ? "" : " and its Monerica reviews")}.";
    if (exFacts.Count == 0) exDesc = $"{ex.Name}: the {Model.CoinTotal} coins it supports, KYC/AML policy and fees{(Model.SupportsXmr ? ", including Monero (XMR) swaps" : "")}.";
    ViewData["MetaDescription"] = exDesc.Length <= 160 ? exDesc : exDesc.Substring(0, 157).TrimEnd() + "...";
    Func<int, string> coinUrl = p => (p <= 1 ? $"/exchanges/{ex.Slug}" : $"/exchanges/{ex.Slug}?cp={p}") + "#coins";
    ViewBag.SponsorRotateIntervalSeconds = 30;
}

<partial name="_SponsorBanner" />

<p class="mb-2"><a asp-page="/Exchanges/Index" class="btn btn-secondary btn-sm">← All exchanges</a></p>

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
    <div>
        <h1 class="h4 mb-1">@ex.Name</h1>
        <div class="text-muted small">
            @(string.IsNullOrEmpty(ex.Kind) ? "Exchange" : ex.Kind)
            @if (!string.IsNullOrEmpty(ex.Grade)) { <span>· Grade <span class="mono">@ex.Grade</span></span> }
            @if (!string.IsNullOrEmpty(ex.CountryCode)) { <span>· @ex.CountryCode</span> }
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.GoUrl))
    {
        <a class="btn btn-primary" href="@Model.GoUrl" target="_blank"
           rel="@(Model.GoIsAffiliate ? "sponsored noopener" : "noopener")">Go to @ex.Name →</a>
    }
</div>

@if (!string.IsNullOrWhiteSpace(ex.Description))
{
    <p class="mb-3">@ex.Description</p>
}
@if (Model.SupportsXmr)
{
    @* Plain-language summary for "{exchange} monero" searches; facts only from the row. *@
    <p class="mb-3 text-muted small">
        @ex.Name supports Monero (XMR) and @(Model.CoinTotal - 1) other coin@(Model.CoinTotal - 1 == 1 ? "" : "s"), so you can swap XMR to or from any of them.
        KYC: @Humanize(ex.Kyc).ToLowerInvariant(). AML policy: @Humanize(ex.Aml).ToLowerInvariant().
        @if (MoneroMarketCap.Pages.Coins.DetailModel.FormatFees(ex) is var lf && lf != "—") { <text>Fees: @lf.</text> }
        Grade and policy data come from SwapRaven.
    </p>
}

<div class="card mb-4">
    <div class="card-header"><h2 class="h6 mb-0">Details</h2></div>
    <div class="card-body p-0">
        <table class="table table-sm mb-0 stats-table">
            <tbody>
                <tr><th>KYC</th><td>@Humanize(ex.Kyc)</td></tr>
                <tr><th>AML policy</th><td>@Humanize(ex.Aml)</td></tr>
                @if (!string.IsNullOrWhiteSpace(ex.Liquidity))
                {
                    <tr><th>Liquidity</th><td>@ex.Liquidity</td></tr>
                }
                <tr><th>Fees</th><td class="mono">@MoneroMarketCap.Pages.Coins.DetailModel.FormatFees(ex)</td></tr>
                @if (ex.ProcessingTimeMinutes is int mins)
                {
                    <tr><th>Typical speed</th><td>@mins min</td></tr>
                }
                <tr>
                    <th>Website</th>
                    <td><a href="@(Model.GoUrl.Length > 0 ? Model.GoUrl : ex.WebsiteUrl)" target="_blank"
                           rel="@(Model.GoIsAffiliate ? "sponsored noopener" : "noopener")">@ex.WebsiteUrl</a></td>
                </tr>
                @if (!string.IsNullOrWhiteSpace(ex.MonericaSlug))
                {
                    <tr>
                        <th>Monerica</th>
                        <td><a href="https://monerica.com/site/@ex.MonericaSlug" target="_blank" rel="noopener">Reviews &amp; details &rarr;</a></td>
                    </tr>
                }
                @if (!string.IsNullOrWhiteSpace(ex.TorUrl))
                {
                    <tr><th>Tor</th><td class="mono text-break">@ex.TorUrl</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div id="coins" class="card mb-4">
    <div class="card-header">
        <h2 class="h6 mb-0">Coins @ex.Name supports (@Model.CoinTotal)</h2>
    </div>
    <div class="card-body">
        @if (Model.CoinTotal == 0)
        {
            <p class="text-muted small mb-0">No coins recorded for this exchange yet.</p>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2">
                @foreach (var c in Model.Coins)
                {
                    @if (c.HasPage)
                    {
                        <a class="badge bg-secondary text-decoration-none" href="/coins/@CoinRoute.Key(c.Symbol, c.CoinGeckoId)" title="@c.Name">@c.Symbol</a>
                    }
                    else
                    {
                        @* No longer tracked: its coin page 404s, so don't link it. *@
                        <span class="badge bg-secondary opacity-50" title="@c.Name (no longer tracked)">@c.Symbol</span>
                    }
                }
            </div>

            @if (Model.CoinTotalPages > 1)
            {
                <nav aria-label="Coin pages" class="mt-3">
                    <ul class="pagination pagination-sm mb-0 flex-wrap">
                        <li class="page-item @(Model.CoinPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@coinUrl(Model.CoinPage - 1)">Prev</a>
                        </li>
                        @for (var p = 1; p <= Model.CoinTotalPages; p++)
                        {
                            <li class="page-item @(p == Model.CoinPage ? "active" : "")">
                                <a class="page-link" href="@coinUrl(p)">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.CoinPage >= Model.CoinTotalPages ? "disabled" : "")">
                            <a class="page-link" href="@coinUrl(Model.CoinPage + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</div>
