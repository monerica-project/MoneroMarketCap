@page "{id:int}"
@model MoneroMarketCap.Pages.Portfolios.DetailModel
@using MoneroMarketCap.Data.Models
@using MoneroMarketCap.Web.Helpers
@{
    ViewData["Title"] = Model.Portfolio?.Name ?? "Portfolio";
    var usd = System.Globalization.CultureInfo.GetCultureInfo("en-US");
    var cur = Model.Currency;
    var rate = Model.RatePerUsd;
    decimal xmrVal(decimal v) => Model.XmrPrice > 0 ? v / Model.XmrPrice : 0;
    var totalAlloc = Model.Allocations.Sum(a => a.ValueUsd);
    string Mask(string v) => Model.PrivacyMode ? "••••" : v;
}

<meta name="format-detection" content="telephone=no" />

@if (Model.Portfolio == null)
{
    <p>Portfolio not found.</p>
    return;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">@Model.Portfolio.Name</h2>
    <div class="text-end">
        <div class="fs-5">Total Value: <strong>@Mask(MoneyFormatter.FormatPrice(Model.Portfolio.TotalValueUsd, cur, rate))</strong></div>
        @if (Model.XmrPrice > 0)
        {
            <div style="color:var(--xmr-text-muted);font-size:0.85rem;white-space:nowrap">
                @Mask($"{xmrVal(Model.Portfolio.TotalValueUsd).ToString("N4", usd)} XMR")
            </div>
        }
        <div class="mt-2">
            <partial name="_PrivacyToggle" />
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ImportMessage))
{
    <div class="alert @(Model.ImportSuccess ? "alert-success" : "alert-warning") mb-3">
        @Model.ImportMessage
    </div>
}

<div class="d-flex gap-2 mb-4 flex-wrap">
    <a asp-page="/Portfolios/Index" class="btn btn-secondary btn-sm">← Back</a>
    <button type="button"
            class="btn btn-outline-secondary btn-sm"
            onclick="const p=document.getElementById('rename-panel');p.style.display=p.style.display==='none'?'':'none';if(p.style.display==='')p.querySelector('input[name=newName]').focus();">
        ✏ Rename
    </button>
    <button type="button"
            class="btn btn-outline-warning btn-sm"
            onclick="const p=document.getElementById('import-panel');p.style.display=p.style.display==='none'?'':'none';">
        ⬆ Import from Monero GUI
    </button>
    <form method="post"
          asp-page-handler="DeletePortfolio"
          asp-route-id="@Model.Portfolio.Id"
          data-portfolio-name="@Model.Portfolio.Name"
          onsubmit="return confirm('Delete portfolio \u201C' + this.dataset.portfolioName + '\u201D? This cannot be undone.')">
        @* The name is user-controlled: it goes in an HTML-encoded data- attribute and is read
           as a plain string, never spliced into the JS source (an apostrophe used to break the
           handler and submit the delete with no confirmation, and allowed script injection). *@
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger btn-sm">🗑 Delete Portfolio</button>
    </form>
</div>

<div id="rename-panel" class="card mb-4" style="display:none;background:var(--xmr-surface);border-color:var(--xmr-border)">
    <div class="card-body">
        <form method="post" asp-page-handler="RenamePortfolio" asp-route-id="@Model.Portfolio.Id" class="d-flex gap-2 flex-wrap align-items-center">
            <label for="newName" class="mb-0">Portfolio name</label>
            <input id="newName" name="newName" class="form-control form-control-sm" style="max-width:22rem"
                   value="@Model.Portfolio.Name" maxlength="@MoneroMarketCap.Pages.Portfolios.DetailModel.MaxPortfolioNameLength" required />
            <button type="submit" class="btn btn-primary btn-sm">Save</button>
        </form>
    </div>
</div>

<div id="import-panel" class="card mb-4" style="display:none;background:var(--xmr-surface);border-color:var(--xmr-border)">
    <div class="card-header">Import XMR Transactions from Monero GUI CSV</div>
    <div class="card-body">
        <p style="color:var(--xmr-text-muted);font-size:0.85rem">
            Export your transactions from the Monero GUI wallet (<em>History → Export as CSV</em>) and upload the file here.
            Transactions will be added to the <strong>XMR</strong> coin in this portfolio.
            <strong>Incoming</strong> becomes Buy, <strong>outgoing</strong> becomes Sell. Historical USD price per day is
            looked up automatically. Duplicates (by txid) are skipped.
        </p>
        <form method="post"
              asp-page-handler="ImportMonero"
              asp-route-id="@Model.Portfolio.Id"
              enctype="multipart/form-data"
              class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-8">
                <label class="form-label">Monero GUI CSV file</label>
                <input type="file" name="ImportFile" accept=".csv,text/csv" class="form-control" required />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary">Import</button>
            </div>
        </form>
    </div>
</div>

@if (Model.Allocations.Any() && totalAlloc > 0 || (!Model.PrivacyMode && Model.PnlSeries.Any()))
{
    <div class="row mb-4">
        @if (Model.Allocations.Any() && totalAlloc > 0)
        {
            <div class="col-lg-5 mb-3">
                <div class="card h-100" style="background:var(--xmr-surface);border-color:var(--xmr-border)">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Allocation</h5>
                        <div style="position:relative;max-width:320px;margin:0 auto">
                            <canvas id="portfolioAllocationChart" style="cursor:pointer"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!Model.PrivacyMode && Model.PnlSeries.Any())
        {
            <div class="col-lg-7 mb-3">
                <div class="card h-100" style="background:var(--xmr-surface);border-color:var(--xmr-border)">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="card-title mb-0" id="pnl-title">Total Value Over Time</h5>
                            <div class="d-flex gap-2 flex-wrap justify-content-end">
                                <div class="btn-group btn-group-sm" role="group" aria-label="What to chart">
                                    <button type="button" class="btn btn-outline-primary" id="pnl-view-pnl" title="Profit and loss over time">P&amp;L</button>
                                    <button type="button" class="btn btn-outline-primary active" id="pnl-view-value" title="Total portfolio value over time, vs. the amount you put in">Total value</button>
                                    <button type="button" class="btn btn-outline-primary" id="pnl-view-held" title="How much XMR you held each day">XMR held</button>
                                </div>
                                <div class="btn-group btn-group-sm" role="group" aria-label="Units" id="pnl-unit-group">
                                    <button type="button" class="btn btn-outline-primary active" id="pnl-toggle-usd">@cur.Code</button>
                                    <button type="button" class="btn btn-outline-primary" id="pnl-toggle-xmr">XMR</button>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                            <div class="btn-group btn-group-sm" role="group" aria-label="Time period" id="pnl-range-group">
                                <button type="button" class="btn btn-outline-secondary" data-range="w" title="Last 7 days">Week</button>
                                <button type="button" class="btn btn-outline-secondary" data-range="m" title="Last 30 days">Month</button>
                                <button type="button" class="btn btn-outline-secondary" data-range="q" title="Last 3 months">Quarter</button>
                                <button type="button" class="btn btn-outline-secondary" data-range="y" title="Last 12 months">Year</button>
                                <button type="button" class="btn btn-outline-secondary active" data-range="all" title="Since the first transaction">All</button>
                            </div>
                            <div id="pnl-range-summary" style="font-size:.9rem;text-align:right"></div>
                        </div>
                        <div style="position:relative;height:280px">
                            <canvas id="pnlChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (!Model.Portfolio.PortfolioCoins.Any())
{
    <p class="text-muted">No coins yet. Add a transaction below.</p>
}
else
{
    <div class="table-responsive mb-4">
        <table class="table market-table" style="font-size:0.82rem">
            <thead>
                <tr>
                    <th>Coin</th>
                    <th class="text-end">Amount</th>
                    <th class="text-end">Price (@cur.Code)</th>
                    <th class="text-end">Value (@cur.Code)</th>
                    @if (Model.XmrPrice > 0)
                    {
                        <th class="text-end">Value (XMR)</th>
                    }
                    <th class="text-end">Basis (@cur.Code)</th>
                    <th class="text-end">P&amp;L (@cur.Code)</th>
                    @if (Model.XmrPrice > 0)
                    {
                        <th class="text-end">P&amp;L (XMR)</th>
                    }
                    <th class="text-end">%</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pc in Model.Portfolio.PortfolioCoins.OrderBy(p => p.Coin.Symbol))
                {
                    var isXmrRow = pc.Coin.Symbol.ToUpper() == "XMR";
                    var pct = Model.Portfolio.TotalValueUsd > 0
                        ? (double)(pc.TotalValueUsd / Model.Portfolio.TotalValueUsd) * 100.0
                        : 0.0;
                    <tr>
                        <td>
                            <div class="coin-name-cell">
                                @if (!string.IsNullOrEmpty(pc.Coin.ImageUrl))
                                {
                                    <a href="/coins/@pc.Coin.Symbol.ToLower()">
                                        <img src="@pc.Coin.ImageUrl" width="18" height="18" style="border-radius:50%;flex-shrink:0" />
                                    </a>
                                }
                                <a href="/coins/@pc.Coin.Symbol.ToLower()" class="coin-symbol" style="color:inherit;text-decoration:none">@pc.Coin.Symbol</a>
                                <a href="/coins/@pc.Coin.Symbol.ToLower()" class="coin-name d-none d-lg-inline" style="color:var(--xmr-text-muted);text-decoration:none">@pc.Coin.Name</a>
                            </div>
                        </td>
                        <td class="text-end mono">@Mask(pc.TotalAmount.ToString("N8", usd))</td>
                        <td class="text-end mono">@MoneyFormatter.FormatPrice(pc.Coin.PriceUsd, cur, rate)</td>
                        <td class="text-end mono">@Mask(MoneyFormatter.FormatPrice(pc.TotalValueUsd, cur, rate))</td>
                        @if (Model.XmrPrice > 0)
                        {
                            <td class="text-end mono xmr-val">
                                @if (isXmrRow)
                                {
                                    <span style="color:var(--xmr-text-muted)">—</span>
                                }
                                else
                                {
                                    @Mask($"{xmrVal(pc.TotalValueUsd).ToString("N4", usd)} XMR")
                                }
                            </td>
                        }
                        @{
                            // Hover: the average price paid per coin for what is still held.
                            var avgPaid = pc.TotalAmount > 0 ? pc.TotalCostBasis / pc.TotalAmount : 0m;
                            var basisTip = Model.PrivacyMode || avgPaid <= 0
                                ? null
                                : $"Average price paid: {MoneyFormatter.FormatPrice(avgPaid, cur, rate)} per {pc.Coin.Symbol.ToUpper()}";
                        }
                        <td class="text-end mono" title="@basisTip" style="@(basisTip != null ? "cursor:help" : null)">@Mask(MoneyFormatter.FormatPrice(pc.TotalCostBasis, cur, rate))</td>
                        <td class="text-end mono @(pc.UnrealizedPnl >= 0 ? "text-success" : "text-danger")">
                            @Mask(MoneyFormatter.FormatPrice(pc.UnrealizedPnl, cur, rate))
                        </td>
                        @if (Model.XmrPrice > 0)
                        {
                            <td class="text-end mono xmr-val @(isXmrRow ? "" : (pc.UnrealizedPnl >= 0 ? "text-success" : "text-danger"))">
                                @if (isXmrRow)
                                {
                                    <span style="color:var(--xmr-text-muted)">—</span>
                                }
                                else
                                {
                                    @Mask($"{xmrVal(pc.UnrealizedPnl).ToString("N4", usd)} XMR")
                                }
                            </td>
                        }
                        <td class="text-end mono">@pct.ToString("N2", usd)%</td>
                        <td class="text-end">
                            <a asp-page="/Portfolios/Transactions"
                               asp-route-portfolioCoinId="@pc.Id"
                               class="btn btn-outline-secondary btn-sm">History</a>
                            <a asp-page="/Portfolios/Transactions"
                               asp-route-portfolioCoinId="@pc.Id"
                               asp-route-walletdiff="1"
                               asp-fragment="wallet-difference"
                               class="btn btn-outline-warning btn-sm"
                               title="Enter your current wallet balance and the needed buy or sell is added for you">Wallet difference</a>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                @{
                    var totalPnl = Model.Portfolio.PortfolioCoins.Sum(p => p.UnrealizedPnl);
                    var totalBasis = Model.Portfolio.PortfolioCoins.Sum(p => p.TotalCostBasis);
                    var totalPnlPct = totalBasis > 0 ? (totalPnl / totalBasis) * 100m : 0m;
                }
                <tr style="border-top:2px solid var(--xmr-border);font-weight:600">
                    <td colspan="3">Total</td>
                    <td class="text-end mono">@Mask(MoneyFormatter.FormatPrice(Model.Portfolio.TotalValueUsd, cur, rate))</td>
                    @if (Model.XmrPrice > 0)
                    {
                        <td class="text-end mono xmr-val">@Mask($"{xmrVal(Model.Portfolio.TotalValueUsd).ToString("N4", usd)} XMR")</td>
                    }
                    <td class="text-end mono">@Mask(MoneyFormatter.FormatPrice(totalBasis, cur, rate))</td>
                    <td class="text-end mono @(totalPnl >= 0 ? "text-success" : "text-danger")">
                        @Mask(MoneyFormatter.FormatPrice(totalPnl, cur, rate))
                        @if (totalBasis > 0)
                        {
                            <div style="font-size:0.85em;font-weight:normal">
                                @(totalPnlPct >= 0 ? "+" : "")@totalPnlPct.ToString("N2", usd)%
                            </div>
                        }
                    </td>
                    @if (Model.XmrPrice > 0)
                    {
                        <td class="text-end mono @(totalPnl >= 0 ? "text-success" : "text-danger") xmr-val">
                            @Mask($"{xmrVal(totalPnl).ToString("N4", usd)} XMR")
                        </td>
                    }
                    <td class="text-end mono">100.00%</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
}

<div class="card mt-2" style="background:var(--xmr-surface);border-color:var(--xmr-border)">
    <div class="card-header">Add Transaction</div>
    <div class="card-body">
        <form method="post" asp-page-handler="AddTransaction" asp-route-id="@Model.Portfolio.Id" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-md-2">
                <label class="form-label">Coin</label>
                <select asp-for="CoinId" asp-items="Model.CoinOptions" class="form-select" id="coin-select"></select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Date (UTC)</label>
                <input asp-for="TransactedAt" type="datetime-local" class="form-control"
                       value="@Model.TransactedAt.ToString("yyyy-MM-ddTHH:mm")" required />
            </div>
            <div class="col-md-1">
                <label class="form-label">Type</label>
                <select asp-for="TransactionType" class="form-select">
                    <option value="Buy">Buy</option>
                    <option value="Sell">Sell</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Amount</label>
                <input asp-for="Amount" type="number" step="any" min="0.000000000001" class="form-control" required title="Amount must be greater than 0" />
            </div>
            <div class="col-md-1">
                <label class="form-label">Price (USD)</label>
                <input asp-for="PriceUsdAtTime" type="number" step="any" min="0" class="form-control" id="price-input" />
            </div>
            <div class="col-md-2">
                <label class="form-label">External ID</label>
                <input asp-for="ExternalTransactionId" class="form-control" placeholder="e.g. transaction ID" />
            </div>
            <div class="col-md-1">
                <label class="form-label">Notes</label>
                <input asp-for="Notes" class="form-control" />
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Add</button>
            </div>
        </form>
    </div>
</div>


<partial name="_SponsorList" />

@section Scripts {
    <script src="~/js/chart.umd.min.js"></script>
    <script>
        const privacyMode = @(Model.PrivacyMode ? "true" : "false");

        // ─── Allocation pie ─────────────────────────────────────
        (function() {
        const C = {
            code:     @Html.Raw(System.Text.Json.JsonSerializer.Serialize(cur.Code)),
            symbol:   @Html.Raw(System.Text.Json.JsonSerializer.Serialize(cur.Symbol)),
            before:   @(cur.SymbolBefore ? "true" : "false"),
            decimals: @cur.Decimals,
            rate:     @rate.ToString(System.Globalization.CultureInfo.InvariantCulture)
        };
        const allocLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Allocations.Select(a => a.Symbol)));
        // Values are USD-canonical from the server; multiply for display.
        const allocValuesUsd = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Allocations.Select(a => (double)a.ValueUsd)));
        const allocValues = allocValuesUsd.map(v => v * C.rate);
        if (allocLabels.length === 0) return;

        const palette = [
        '#4a90e2', '#50c878', '#e74c3c', '#9b59b6', '#f1c40f',
        '#1abc9c', '#e67e22', '#34495e', '#ff69b4', '#2ecc71',
        '#8e44ad', '#3498db', '#d35400', '#16a085', '#c0392b'
        ];
        const xmrOrange = '#ff6600';
        let idx = 0;
        const colors = allocLabels.map(l => l === 'XMR' ? xmrOrange : palette[idx++ % palette.length]);
        const total = allocValues.reduce((s, v) => s + v, 0);

        const canvas = document.getElementById('portfolioAllocationChart');
        if (!canvas) return;
        new Chart(canvas.getContext('2d'), {
        type: 'pie',
        data: {
        labels: allocLabels,
        datasets: [{ data: allocValues, backgroundColor: colors, borderColor: 'rgba(0,0,0,0.3)', borderWidth: 1 }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: true,
        onClick: function(evt, els) {
        if (els && els.length > 0) window.location.href = '/coins/' + allocLabels[els[0].index].toLowerCase();
        },
        onHover: function(evt, els) {
        evt.native.target.style.cursor = (els && els.length > 0) ? 'pointer' : 'default';
        },
        plugins: {
        legend: {
        position: 'bottom',
        labels: { color: getComputedStyle(document.body).color },
        onClick: function(evt, item) { window.location.href = '/coins/' + item.text.toLowerCase(); }
        },
        tooltip: {
        callbacks: {
        label: function(c) {
        const v = c.parsed;
        const pct = total > 0 ? (v / total * 100).toFixed(2) : '0.00';
        if (privacyMode) {
        return c.label + ': ' + pct + '%';
        }
        return c.label + ': $' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' (' + pct + '%)';
        }
        }
        }
        }
        }
        });
        })();

        // ─── P&L over time (hidden in privacy mode) ─────────────
        (function() {
        if (privacyMode) return;

        // Currency context — values stored as PnlUsd, multiplied for display.
        const C = {
            code:     @Html.Raw(System.Text.Json.JsonSerializer.Serialize(cur.Code)),
            symbol:   @Html.Raw(System.Text.Json.JsonSerializer.Serialize(cur.Symbol)),
            before:   @(cur.SymbolBefore ? "true" : "false"),
            decimals: @cur.Decimals,
            rate:     @rate.ToString(System.Globalization.CultureInfo.InvariantCulture)
        };
        function wrapMoney(numberPart) {
            return C.before ? C.symbol + numberPart : numberPart + ' ' + C.symbol;
        }

        const pnlSeries = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    Model.PnlSeries,
                    new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }
                    ));
        if (!pnlSeries || pnlSeries.length === 0) return;

        const canvas = document.getElementById('pnlChart');
        if (!canvas) return;

        // view: 'pnl' | 'value' (portfolio value vs. amount put in) | 'held' (XMR amount held).
        // unit: 'fiat' (display currency) or 'xmr' — applies to 'pnl' and 'value'. Values are
        // stored in USD and multiplied by the FX rate for the display currency.
        let view = 'value'; // default: total value over time
        let mode = 'fiat';
        // Time period shown: last week / month / quarter / year, or everything. The series is one
        // point per day, so a period is simply the last N days (plus the day it starts from).
        const RANGE_DAYS = { w: 7, m: 30, q: 91, y: 365 };
        const RANGE_NAMES = { w: 'Past week', m: 'Past month', q: 'Past quarter', y: 'Past year', all: 'All time' };
        let range = 'all';
        try { const saved = localStorage.getItem('mmc-portfolio-range'); if (saved && RANGE_NAMES[saved]) range = saved; } catch (e) { }
        let pts = pnlSeries;
        function applyRange() {
            const n = RANGE_DAYS[range];
            pts = n ? pnlSeries.slice(-(n + 1)) : pnlSeries;
        }
        applyRange();
        const labelsFor = () => pts.map(p => new Date(p.timestampMs).toISOString().slice(0, 10));
        const titles = { pnl: 'P&L Over Time', value: 'Total Value Over Time', held: 'XMR Held Over Time' };
        const inFiat = v => v * C.rate;

        function fmtVal(v, digits) {
            if (view === 'held' || mode === 'xmr') return v.toFixed(view === 'held' ? 4 : 4) + ' XMR';
            return wrapMoney(v.toLocaleString('en-US', { minimumFractionDigits: digits, maximumFractionDigits: digits }));
        }

        function datasetsFor() {
            const line = (label, data, color, fill, dashed) => ({
                label: label, data: data, borderColor: color,
                backgroundColor: fill ? color.replace('1)', '0.1)') : 'transparent',
                borderWidth: 2, borderDash: dashed ? [6, 4] : [], fill: fill,
                tension: 0.2, pointRadius: 0, pointHoverRadius: 4,
                stepped: false
            });
            const unit = mode === 'fiat' ? C.code : 'XMR';
            if (view === 'held') {
                const d = line('XMR held', pts.map(p => p.xmrHeld), 'rgba(255, 102, 0, 1)', true, false);
                d.stepped = 'before'; d.tension = 0;
                return [d];
            }
            if (view === 'value') {
                return [
                    line('Total value (' + unit + ')', pts.map(p => mode === 'fiat' ? inFiat(p.valueUsd) : p.valueXmr), 'rgba(255, 102, 0, 1)', true, false),
                    line('Amount put in (' + unit + ')', pts.map(p => mode === 'fiat' ? inFiat(p.basisUsd) : p.basisXmr), 'rgba(160, 160, 160, 1)', false, true)
                ];
            }
            return [line('P&L (' + unit + ')', pts.map(p => mode === 'fiat' ? inFiat(p.pnlUsd) : p.pnlXmr), 'rgba(255, 102, 0, 1)', true, false)];
        }

        const chart = new Chart(canvas.getContext('2d'), {
        type: 'line',
        data: { labels: labelsFor(), datasets: datasetsFor() },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { intersect: false, mode: 'index' },
        scales: {
        x: {
        ticks: { color: getComputedStyle(document.body).color, maxRotation: 0, autoSkip: true, maxTicksLimit: 8 },
        grid: { color: 'rgba(128,128,128,0.15)' }
        },
        y: {
        ticks: {
        color: getComputedStyle(document.body).color,
        callback: function(val) {
        if (view === 'held' || mode === 'xmr') return val.toFixed(view === 'held' ? 2 : 4) + ' XMR';
        return wrapMoney(val.toLocaleString('en-US', { maximumFractionDigits: 0 }));
        }
        },
        grid: { color: 'rgba(128,128,128,0.15)' }
        }
        },
        plugins: {
        legend: { display: false, labels: { color: getComputedStyle(document.body).color, boxWidth: 18 } },
        tooltip: {
        callbacks: {
        label: function(c) {
        const name = view === 'held' ? 'XMR held' : (view === 'value' ? c.dataset.label.replace(/ \(.*\)$/, '') : 'P&L');
        return name + ': ' + fmtVal(c.parsed.y, C.decimals);
        }
        }
        }
        }
        }
        });

        // "Past month: $1,200.00 → $1,450.00  ▲ +$250.00 (+20.8%)" for whatever is being charted.
        function renderSummary() {
            const el = document.getElementById('pnl-range-summary');
            if (!el || pts.length === 0) return;
            const pick = p => view === 'held' ? p.xmrHeld
                : view === 'value' ? (mode === 'fiat' ? inFiat(p.valueUsd) : p.valueXmr)
                : (mode === 'fiat' ? inFiat(p.pnlUsd) : p.pnlXmr);
            const first = pick(pts[0]), last = pick(pts[pts.length - 1]);
            const diff = last - first;
            const up = diff >= 0;
            const pct = (view !== 'pnl' && first > 0) ? ' (' + (up ? '+' : '') + (diff / first * 100).toFixed(1) + '%)' : '';
            const days = pts.length - 1;
            const wanted = RANGE_DAYS[range];
            const name = (wanted && days < wanted) ? 'Since start (' + days + ' day' + (days === 1 ? '' : 's') + ')' : RANGE_NAMES[range];
            el.innerHTML = '';
            const a = document.createElement('span');
            a.style.color = 'var(--xmr-text-muted)';
            a.textContent = name + ': ' + fmtVal(first, C.decimals) + ' → ' + fmtVal(last, C.decimals) + '  ';
            const b = document.createElement('strong');
            b.className = up ? 'text-success' : 'text-danger';
            b.textContent = (up ? '▲ +' : '▼ −') + fmtVal(Math.abs(diff), C.decimals) + pct;
            el.appendChild(a); el.appendChild(b);
        }

        function render() {
        applyRange();
        chart.data.labels = labelsFor();
        chart.data.datasets = datasetsFor();
        chart.options.plugins.legend.display = view === 'value';
        chart.update();
        document.getElementById('pnl-title').textContent = titles[view];
        document.getElementById('pnl-toggle-usd').classList.toggle('active', mode === 'fiat');
        document.getElementById('pnl-toggle-xmr').classList.toggle('active', mode === 'xmr');
        document.getElementById('pnl-unit-group').style.visibility = view === 'held' ? 'hidden' : 'visible';
        ['pnl', 'value', 'held'].forEach(v => document.getElementById('pnl-view-' + v).classList.toggle('active', view === v));
        document.querySelectorAll('#pnl-range-group [data-range]').forEach(b => b.classList.toggle('active', b.getAttribute('data-range') === range));
        renderSummary();
        }
        document.querySelectorAll('#pnl-range-group [data-range]').forEach(b => b.addEventListener('click', () => {
            range = b.getAttribute('data-range');
            try { localStorage.setItem('mmc-portfolio-range', range); } catch (e) { }
            render();
        }));
        document.getElementById('pnl-toggle-usd').addEventListener('click', () => { mode = 'fiat'; render(); });
        document.getElementById('pnl-toggle-xmr').addEventListener('click', () => { mode = 'xmr'; render(); });
        ['pnl', 'value', 'held'].forEach(v => document.getElementById('pnl-view-' + v).addEventListener('click', () => { view = v; render(); }));
        render(); // apply the default view (legend, title, buttons)
        })();

        // ─── Existing: price auto-fill on coin select ──────────
        const prices = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CoinPrices));
        const coinSelect = document.getElementById('coin-select');
        const priceInput = document.getElementById('price-input');

        function updatePrice() {
        const id = parseInt(coinSelect.value);
        if (prices[id] !== undefined) {
        priceInput.value = prices[id];
        }
        }

        coinSelect.addEventListener('change', updatePrice);
        updatePrice();
    </script>
}